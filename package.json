{
  "name": "github-panel",
  "author": "lumine-code",
  "main": "./lib/index",
  "files": [
    "img",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "version": "1.0.0",
  "description": "A GitHub integration panel.",
  "keywords": [
    "pull-request",
    "code-review",
    "issue",
    "pr",
    "review",
    "repository"
  ],
  "repository": "https://github.com/lumine-code/github-panel",
  "bugs": {
    "url": "https://github.com/lumine-code/github-panel/issues"
  },
  "homepage": "https://github.com/lumine-code/github-panel#readme",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "backgroundTips": [
    "You can review pull requests and issues from the GitHub panel with {{ 'github-panel:toggle-focus' | keystroke }}"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "classnames": "2.5.1",
    "dayjs": "^1.11.21",
    "dompurify": "3.4.13",
    "marked": "18.0.9",
    "node-emoji": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-select": "^5.10.2",
    "react-tabs": "6.1.1"
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "git-panel": {
      "versions": {
        "^1.0.0": "consumeGitPanel"
      }
    }
  },
  "configSchema": {
    "oauthClientId": {
      "title": "GitHub OAuth Client ID",
      "description": "Client ID of a GitHub OAuth App (with Device Flow enabled) used for browser sign-in. Leave blank to sign in with a personal access token instead.",
      "type": "string",
      "default": ""
    },
    "openGitHubTabOnStart": {
      "description": "Automatically open the GitHub tab when the editor starts",
      "type": "boolean",
      "default": false
    },
    "debug": {
      "description": "Log additional debug information to the console, including caught errors and diagnostics",
      "type": "boolean",
      "default": false
    }
  },
  "deserializers": {
    "IssueishDetailItem": "createIssueishPaneItemStub",
    "IssueishPaneItem": "createIssueishPaneItemStub",
    "GithubDockItem": "createDockItemStub",
    "ReviewsStub": "createReviewsStub"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}

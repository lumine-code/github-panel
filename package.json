{
  "name": "github-panel",
  "author": "lumine-code",
  "main": "./lib/index",
  "version": "2.0.0",
  "description": "A GitHub integration panel for Lumine.",
  "repository": "https://github.com/lumine-code/github-panel",
  "bugs": {
    "url": "https://github.com/lumine-code/github-panel/issues"
  },
  "homepage": "https://github.com/lumine-code/github-panel#readme",
  "license": "MIT",
  "engines": {
    "atom": "*",
    "node": ">=20"
  },
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../github-panel/spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "classnames": "2.5.1",
    "dayjs": "^1.11.21",
    "dompurify": "3.4.12",
    "marked": "18.0.7",
    "node-emoji": "^2.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-select": "^5.10.2",
    "react-tabs": "6.1.1",
    "what-the-diff": "0.6.0",
    "yubikiri": "2.0.0"
  },
  "consumedServices": {
    "status-bar": {
      "versions": {
        "^1.0.0": "consumeStatusBar"
      }
    },
    "github-panel.git-bridge": {
      "versions": {
        "^0.1.0": "consumeGitHubBridge"
      }
    }
  },
  "configSchema": {
    "oauthClientId": {
      "title": "GitHub OAuth Client ID",
      "description": "Client ID of a GitHub OAuth App (with Device Flow enabled) used for browser sign-in. Leave blank to sign in with a personal access token instead.",
      "type": "string",
      "default": ""
    },
    "openGitHubTabOnStart": {
      "description": "Automatically open the GitHub tab when the editor starts",
      "type": "boolean",
      "default": false
    },
    "debug": {
      "description": "Log additional debug information to the console, including caught errors and diagnostics",
      "type": "boolean",
      "default": false
    }
  },
  "deserializers": {
    "IssueishDetailItem": "createIssueishPaneItemStub",
    "IssueishPaneItem": "createIssueishPaneItemStub",
    "GithubDockItem": "createDockItemStub",
    "ReviewsStub": "createReviewsStub"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.7.0",
    "prettier": "^3.9.6"
  }
}

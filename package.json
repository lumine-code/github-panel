{
  "name": "github-panel",
  "author": "lumine-code",
  "main": "./lib/index",
  "files": [
    "benchmark",
    "docs",
    "img",
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "version": "1.0.0",
  "description": "A GitHub integration panel.",
  "keywords": [
    "pull-request",
    "code-review",
    "issue",
    "pr",
    "review",
    "repository"
  ],
  "repository": "https://github.com/lumine-code/github-panel",
  "bugs": {
    "url": "https://github.com/lumine-code/github-panel/issues"
  },
  "homepage": "https://github.com/lumine-code/github-panel#readme",
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "benchmark": "lumine --test benchmark"
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    },
    "git.commit-links": {
      "versions": {
        "1.0.0": "provideCommitLinks"
      }
    }
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#09b0556a819a3fd975130066ea5b408c2da25ce3",
    "classnames": "2.5.1",
    "dayjs": "^1.11.23",
    "dompurify": "3.4.16",
    "marked": "18.1.0",
    "node-emoji": "^2.2.0"
  },
  "consumedServices": {
    "git-panel": {
      "versions": {
        "^1.0.0": "consumeGitPanel"
      }
    },
    "patch-view": {
      "versions": {
        "^1.0.0": "consumePatchView"
      }
    }
  },
  "specPackages": [
    "patch-view",
    "git-panel"
  ],
  "configSchema": {
    "remoteFetchProtocol": {
      "title": "Remote Fetch Protocol",
      "description": "Protocol used when cloning or publishing a repository on GitHub.",
      "type": "string",
      "enum": [
        "https",
        "ssh"
      ],
      "default": "https"
    },
    "oauthClientId": {
      "title": "GitHub OAuth Client ID",
      "description": "Client ID of a GitHub OAuth App (with Device Flow enabled) used for browser sign-in. Leave blank to sign in with a personal access token instead.",
      "type": "string",
      "default": ""
    },
    "openGitHubTabOnStart": {
      "title": "Open GitHub Tab on Start",
      "description": "Automatically open the GitHub tab when the editor starts",
      "type": "boolean",
      "default": false
    },
    "debug": {
      "title": "Debug Logging",
      "description": "Log additional debug information to the console, including caught errors and diagnostics",
      "type": "boolean",
      "default": false
    }
  },
  "deserializers": {
    "IssueishDetailItem": "createIssueishPaneItemStub",
    "IssueishPaneItem": "createIssueishPaneItemStub",
    "GithubDockItem": "createDockItemStub",
    "ReviewsStub": "createReviewsStub"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}

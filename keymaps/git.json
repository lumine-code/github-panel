{
  // `alt-g` is the git family's chord prefix, shared with git-panel,
  // open-repository, git-diff and git-command. It is never a complete binding
  // on its own: an exact match alongside a chord prefix stalls every press for
  // a second while the keymap waits for the rest of the chord.
  "lumine-workspace": {
    "alt-g h": "github-panel:toggle-focus"
  },
  ".github-panel-Dialog": {
    "tab": "core:focus-next",
    "shift-tab": "core:focus-previous"
  },
  ".github-panel-Dialog input": {
    "enter": "core:confirm"
  },
  ".github-panel-TabbableWrapper": {
    "down": "github-panel:selectbox-down",
    "up": "github-panel:selectbox-up",
    "enter": "github-panel:selectbox-enter",
    "tab": "github-panel:selectbox-tab",
    "backspace": "github-panel:selectbox-backspace",
    "pageup": "github-panel:selectbox-pageup",
    "pagedown": "github-panel:selectbox-pagedown",
    "end": "github-panel:selectbox-end",
    "home": "github-panel:selectbox-home",
    "delete": "github-panel:selectbox-delete",
    "escape": "github-panel:selectbox-escape"
  },
  ".github-panel-Reviews": {
    "cmdorctrl-=": "github-panel:more-context",
    "cmdorctrl--": "github-panel:less-context"
  },
  ".github-panel-Reviews lumine-text-editor": {
    "cmdorctrl-enter": "github-panel:submit-comment"
  }
}
